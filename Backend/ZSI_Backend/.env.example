# ZSI Wildlife API Configuration

# API key the app sends in X-API-Key. Required: the server refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZSI_API_KEY=your-secure-api-key-here

# Secret for signing OTP tokens (min 16 chars). Must differ from ZSI_API_KEY and be
# identical on every instance. OTP login is disabled if unset.
ZSI_OTP_SECRET=another-long-random-secret

# Local testing only: return OTP codes in the API response instead of sending SMS.
# ZSI_OTP_DEV_ECHO=1

# CORS allowed origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com

# Flask environment
FLASK_ENV=production

# Optional: Custom host/port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Model weights (not in git). Defaults: models/zsi_wildlife_model.pth and models/ensemble/
# ZSI_MODEL_PATH=models/zsi_wildlife_model.pth
# ZSI_ENSEMBLE_DIR=models/ensemble

# SMS gateway for OTP codes and alerts: goi (SMS_API_KEY) or twilio
# SMS_PROVIDER=goi
# SMS_API_KEY=

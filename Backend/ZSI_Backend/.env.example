# ZSI Wildlife API Configuration

# API Key for authentication (generate a strong key for production)
ZSI_API_KEY=your-secure-api-key-here

# CORS allowed origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com

# Flask environment
FLASK_ENV=production

# Optional: Custom host/port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
